# Copy to .env for the live model path. The offline path (mock model, tests,
# eval) needs none of these.

# Required only for --live / the running service with TRIAGE_LIVE=1.
ANTHROPIC_API_KEY=

# Optional tuning (defaults shown).
TRIAGE_MODEL=claude-opus-5
TRIAGE_EFFORT=high
TRIAGE_MAX_STEPS=6
TRIAGE_MAX_COST_USD=0.50
TRIAGE_AUTO_CLOSE_MIN_CONFIDENCE=0.80
TRIAGE_DATA_DIR=data/synthetic

# Set to 1 to make the HTTP service use the real model.
TRIAGE_LIVE=0
